{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "OhMyPos Next.js",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "plugins": [{ "name": "next" }]
  }
}
