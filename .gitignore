# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
.next/
out/
*.tsbuildinfo

# turborepo
.turbo/

# test output
coverage/

# env — never commit real secrets (Handbook §6: synthetic data only)
.env
.env.*
!.env.example
!.env.*.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Prisma 7 emits the client as TypeScript into the source tree — generated, never edited by hand.
apps/api/src/generated/

# local execution prompts for future phases — not repo content
docs/planning-prompts/

# local phase plans and AI-review remediation specs — working documents, not repo content
docs/plannings/
docs/plannings-v2/
docs/remediations/
docs/reports/

# playwright MCP snapshot artifacts — generated during E2E sessions, not repo content
.playwright-mcp/
# Playwright storageState auth files — contain session cookies, never commit
apps/web/e2e/.auth/*.json

# real bank e-statements used as parser reference — contain account numbers,
# holder and counterparty names. Test fixtures are generated synthetically
# instead (ADR-022, ADR-026), so this directory is default-deny for PDFs and the
# generated samples are allow-listed by name.
docs/e-statement/
docs/e-statements/*.pdf
!docs/e-statements/0[0-9]-mandiri-*.pdf
!docs/e-statements/0[0-9]-bca-*.pdf

# test results and sweep artifacts
apps/web/test-results/
docs/testing/

.agents/
docs/portfolio/
docs/handoff/

# db dump files — never commit (see docs/runbooks/backup-restore.md)
backups/