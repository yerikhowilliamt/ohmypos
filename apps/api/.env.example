# Copy to .env and fill in. Never commit the real .env (Handbook §3, §6).

# Host-run (`pnpm dev`) targets the compose Postgres on 5433 — a native
# PostgreSQL already owns 5432 on the dev machine. Inside docker-compose the
# api service overrides this with `postgres:5432` on the compose network.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ohmypos_db?schema=public"

PORT=4013
NODE_ENV=development

# Comma-separated. apps/web runs on 3001.
CORS_ORIGIN="http://localhost:3001"

# JWT — Phase 2 (ADR-011). Generate real values (minimum 32 characters); these are placeholders.
JWT_SECRET="change-me-access-secret-minimum-32-chars-ok"
JWT_REFRESH_SECRET="change-me-refresh-secret-minimum-32-chars-ok"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="30d"

# Cloudinary — Phase 10b (ADR-020). Get real values from
# the Cloudinary dashboard; these are placeholders.
CLOUDINARY_CLOUD_NAME="change-me"
CLOUDINARY_API_KEY="change-me"
CLOUDINARY_API_SECRET="change-me"

# Device-cookie HMAC signing key — Phase 11 (minimum 32 characters).
DEVICE_COOKIE_SECRET="change-me-device-cookie-secret-min-32-chars"
