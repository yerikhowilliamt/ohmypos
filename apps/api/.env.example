# Copy to .env and fill in. Never commit the real .env (Handbook §3, §6).

# Host-run (`pnpm dev`) targets the compose Postgres on 5433 — a native
# PostgreSQL already owns 5432 on the dev machine. Inside docker-compose the
# api service overrides this with `postgres:5432` on the compose network.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ohmypos_db?schema=public"

PORT=4013
NODE_ENV=development

# Comma-separated. apps/web runs on 3001.
CORS_ORIGIN="http://localhost:3001"

# JWT — Phase 2 (ADR-011). Generate real values (minimum 32 characters); these are placeholders.
JWT_SECRET="change-me-access-secret-minimum-32-chars-ok"
JWT_REFRESH_SECRET="change-me-refresh-secret-minimum-32-chars-ok"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="30d"

# Platform (super admin) JWT — ADR-025 Fase 3. A SEPARATE key pair from the
# tenant one above on purpose: it is what makes a tenant token fail signature
# verification on /platform/* and a platform token fail on tenant routes.
# Minimum 32 characters.
PLATFORM_JWT_SECRET="change-me-platform-access-secret-min-32-chars"
PLATFORM_JWT_REFRESH_SECRET="change-me-platform-refresh-secret-min-32-chars"

# Cloudinary — Phase 10b (ADR-020). Get real values from
# the Cloudinary dashboard; these are placeholders.
CLOUDINARY_CLOUD_NAME="change-me"
CLOUDINARY_API_KEY="change-me"
CLOUDINARY_API_SECRET="change-me"

# Device-cookie HMAC signing key — Phase 11 (minimum 32 characters).
DEVICE_COOKIE_SECRET="change-me-device-cookie-secret-min-32-chars"

# ---------------------------------------------------------------------------
# Demo tenant seed (`pnpm --filter api db:seed:demo -- --yes`) — TASK-134.
#
# Only read by `prisma/seed-demo.ts`, never by the running API, so these stay
# COMMENTED OUT and are passed on the command line for the one run that needs
# them. The script has no defaults for any of them on purpose: a demo tenant
# seeded into production must not inherit a password from a checked-in file.
#
# DEMO_TENANT_SLUG must not be "default" — that is the real business's tenant
# (`scripts/create-owner.ts`), and the script refuses it.
# ---------------------------------------------------------------------------
# DEMO_TENANT_SLUG="demo-kopi-senja"
# DEMO_TENANT_NAME="Kopi Senja"
# DEMO_OWNER_NAME="Budi Santoso"
# DEMO_OWNER_EMAIL="budi@kopisenja.demo"
# DEMO_OWNER_PASSWORD="minimum-8-karakter"
# Defaults to DEMO_OWNER_PASSWORD when unset.
# DEMO_STAFF_PASSWORD="minimum-8-karakter"
# Staff emails are derived, not fixed: `User.email` is unique across ALL
# tenants (ADR-025), so a hardcoded admin@… would collide on the second demo.
# DEMO_STAFF_EMAIL_DOMAIN="demo-kopi-senja.ohmypos.demo"
# Scales restock quantities and daily sales together. 1-10, default 1 (~150 sales).
# DEMO_VOLUME="1"
