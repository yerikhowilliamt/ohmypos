# Copy to .env.test and fill in. Never commit the real .env.test (Handbook §3, §6).
#
# Loaded by test/setup-e2e.ts for `pnpm --filter api test:e2e`. Must point at a
# database dedicated to the e2e suite, never the one `pnpm dev` uses — the suite's
# resetDatabase() truncates everything (DEBT-020).
#
# One-time setup:
#   docker exec ohmypos-postgres psql -U postgres -c "CREATE DATABASE ohmypos_e2e;"
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ohmypos_e2e?schema=public" \
#     pnpm --filter api exec prisma migrate deploy
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ohmypos_e2e?schema=public&connection_limit=60&pool_timeout=30"

PORT=4015
NODE_ENV=test

# The concurrency suite (B1-B4) legitimately fires well over the production
# default of 100 requests/60s from one IP (127.0.0.1).
THROTTLE_LIMIT=1000

CORS_ORIGIN="http://localhost:3001"

JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="30d"

# Platform (super admin) JWT — ADR-025 Fase 3. A SEPARATE key pair from the
# tenant one above on purpose: it is what makes a tenant token fail signature
# verification on /platform/* and a platform token fail on tenant routes.
# Minimum 32 characters.
PLATFORM_JWT_SECRET="change-me-platform-access-secret"
PLATFORM_JWT_REFRESH_SECRET="change-me-platform-refresh-secret"

CLOUDINARY_CLOUD_NAME="change-me"
CLOUDINARY_API_KEY="change-me"
CLOUDINARY_API_SECRET="change-me"

DEVICE_COOKIE_SECRET="change-me-device-cookie-secret"
