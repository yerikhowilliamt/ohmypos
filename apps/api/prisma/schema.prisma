// OhMyPos schema. Design notes: prisma/README.md and docs/03 - ERD.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Required for the generated TypeScript to compile under CommonJS.
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums — Kasync's literal names. Do not rename (ADR-012).
// ---------------------------------------------------------------------------

enum AccountType {
  BANK
  CASH
  EWALLET
}

enum TransactionType {
  INFLOW
  OUTFLOW
}

enum TransactionStatus {
  UNRESOLVED // no candidate match found / zero allocation
  PENDING_REVIEW // matching engine proposed a candidate, awaiting confirmation
  PARTIALLY_ALLOCATED // sum(allocation) < amount
  MATCHED // sum(allocation) == amount
}

enum AllocationStatus {
  ACTIVE
  REVOKED
}

/// Staff roles (ADR-011). Never reintroduce `CASHIER`.
enum UserRole {
  KASIR
  ADMIN
  OWNER
}

/// What generated a LedgerEntry.
enum LedgerSourceType {
  MANUAL
  SALE
  PURCHASE
  PAYABLE_SETTLEMENT
  /// The reversal entry a sale void writes (DEBT-010). For audit legibility only.
  SALE_VOID
}

/// Sale status (DEBT-010 interim void; no partial refund).
enum SaleStatus {
  COMPLETED
  VOIDED
}

/// PARTIALLY_PAID is written only by settlements, never at creation (ADR-006).
enum PaymentStatus {
  PAID
  UNPAID
  PARTIALLY_PAID
}

/// OhMyPos — ERD §3.
enum PayableStatus {
  OPEN
  PARTIALLY_SETTLED
  SETTLED
}

/// OhMyPos — ERD §3.
enum StockDirection {
  IN
  OUT
}

/// ADJUSTMENT has no writer yet, deliberately.
enum StockReferenceType {
  SALE
  PURCHASE
  OPENING
  ADJUSTMENT
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Account {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name String
  type AccountType

  /// OhMyPos — Kas Awal (PRD §5.1). Kasync's Account has no balance column.
  openingBalance Decimal @default(0) @map("opening_balance") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bankTransactions   BankTransaction[]
  ledgerEntries      LedgerEntry[]
  payableSettlements PayableSettlement[]
  sales              Sale[]

  @@index([tenantId])
  @@map("accounts")
}

model Category {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name String

  /// OhMyPos — Kasync's Category is id/name only.
  type TransactionType

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ledgerEntries LedgerEntry[]

  @@unique([tenantId, name])
  @@map("categories")
}

model Branch {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name    String
  /// OhMyPos.
  address String?

  /// The system branch (ADR-014): one per tenant, the lookup key (not the name).
  isSystem Boolean @default(false) @map("is_system")

  /// The main store; one per tenant (partial unique index).
  isMainStore Boolean @default(false) @map("is_main_store")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ledgerEntries     LedgerEntry[]
  users             User[]
  supplierPurchases SupplierPurchase[]
  stockMovements    StockMovement[]
  sales             Sale[]
  devices           Device[]

  @@unique([tenantId, name])
  @@map("branches")
}

model LedgerEntry {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Required: the account the money moved through.
  accountId String @map("account_id")

  /// Required, so system categories must exist (ensureSystemRefs).
  categoryId String @map("category_id")

  branchId String @map("branch_id")

  entryDate DateTime        @map("entry_date")
  amount    Decimal         @db.Decimal(18, 2)
  type      TransactionType @default(OUTFLOW)

  /// OhMyPos — traceability back to the event that generated this entry.
  sourceType LedgerSourceType @default(MANUAL) @map("source_type")
  sourceId   String?          @map("source_id")

  note String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Restrict, not Cascade: deleting an Account must never delete financial history.
  account  Account  @relation(fields: [accountId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  allocations Allocation[]

  /// At most one of these generated the entry; `sourceType` says which.
  supplierPurchase  SupplierPurchase?
  payableSettlement PayableSettlement?
  sale              Sale?

  @@index([entryDate])
  @@index([categoryId])
  @@index([branchId])
  /// OhMyPos — every Dashboard 3 report filters by date and often by branch (ERD §6).
  @@index([branchId, entryDate])
  /// OhMyPos — trace a ledger entry back to its Sale/Purchase/Settlement.
  @@index([sourceType, sourceId])
  @@index([tenantId, branchId, entryDate])
  @@map("ledger_entries")
}

model BankTransaction {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  accountId   String          @map("account_id")
  txnDate     DateTime        @map("txn_date")
  amount      Decimal         @db.Decimal(18, 2)
  type        TransactionType @default(OUTFLOW)
  description String

  /// Bank-side reference; one of the two import de-duplication keys.
  externalRef String? @map("external_ref")
  dedupHash   String? @map("dedup_hash")

  /// Synced by trg_sync_transaction_status.
  status TransactionStatus @default(UNRESOLVED)

  importedAt DateTime @default(now()) @map("imported_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  allocations Allocation[]

  // Together these prevent importing the same bank row twice into one account.
  @@unique([accountId, externalRef])
  @@unique([accountId, dedupHash])
  @@index([txnDate])
  @@index([status])
  @@index([tenantId])
  @@map("bank_transactions")
}

model Allocation {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  bankTransactionId String  @map("bank_transaction_id")
  ledgerEntryId     String  @map("ledger_entry_id")
  amountPortion     Decimal @map("amount_portion") @db.Decimal(18, 2)

  status    AllocationStatus @default(ACTIVE)
  /// Set when status becomes REVOKED — revocation is a state change, never a delete.
  revokedAt DateTime?        @map("revoked_at")

  /// Makes repeated allocation-create calls idempotent rather than duplicating.
  idempotencyKey String? @map("idempotency_key")

  /// Append-only: Kasync's allocations table has no updated_at.
  createdAt DateTime @default(now()) @map("created_at")

  bankTransaction BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  ledgerEntry     LedgerEntry     @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)

  @@unique([bankTransactionId, idempotencyKey])
  @@index([bankTransactionId])
  @@index([ledgerEntryId])
  @@index([tenantId])
  @@map("allocations")
}

model User {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name         String
  email        String @unique
  passwordHash String @map("password_hash")

  /// Ported from Kasync's Auth pattern — supports refresh-token rotation.
  refreshTokenHash String? @map("refresh_token_hash")

  role UserRole

  /// Required for KASIR, null for ADMIN/OWNER (enforced in Zod and the service, ADR-011).
  branchId String? @map("branch_id")

  /// Cloudinary secure_url (ADR-020).
  photoUrl String? @map("photo_url")

  /// Soft deactivation; users are never deleted (Sale.userId audit trail).
  isActive Boolean @default(true) @map("is_active")

  /// Tokens issued before this are rejected (session revocation).
  tokenValidFrom DateTime @default(now()) @map("token_valid_from")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sales       Sale[]  @relation("SaleCashier")
  /// Sales this user voided; separate from `sales` (the cashier relation).
  voidedSales Sale[]  @relation("SaleVoidedBy")

  /// Devices activated (as OWNER) and own attendance records (as KASIR).
  activatedDevices  Device[]
  attendanceRecords AttendanceRecord[]

  /// Leave requests filed, and leave requests reviewed.
  leaveRequests         LeaveRequest[] @relation("LeaveRequestUser")
  reviewedLeaveRequests LeaveRequest[] @relation("LeaveRequestReviewer")

  /// BranchScopeGuard filters on this for every KASIR-scoped request (ERD §6).
  @@index([branchId])
  @@index([tenantId])
  @@map("users")
}

/// Raw material: the only place stock lives (ADR-004).
model RawMaterial {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name String

  /// Stock/recipe base unit; every quantity is in it. Immutable once movements exist (ADR-024).
  unit String

  /// The pack the supplier sells. Editable; purchase lines keep a snapshot (ADR-024).
  purchaseUnit String @map("purchase_unit")

  /// `unit` per `purchaseUnit` (1 ekor = 10 pcs → 10). Strictly positive.
  conversionFactor Decimal @default(1) @map("conversion_factor") @db.Decimal(18, 4)

  /// Cost per stock unit (a rate, hence 6dp), set by the latest purchase (ADR-024).
  unitCost Decimal @map("unit_cost") @db.Decimal(18, 6)

  /// Running balance, written only with its StockMovement under FOR UPDATE (ADR-007).
  currentStock Decimal @default(0) @map("current_stock") @db.Decimal(18, 4)

  lowStockThreshold Decimal @default(0) @map("low_stock_threshold") @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recipeItems    RecipeItem[]
  purchaseItems  SupplierPurchaseItem[]
  stockMovements StockMovement[]
  openingStocks  OpeningStock[]

  @@unique([tenantId, name])
  @@map("raw_materials")
}

/// Product. No stored HPP or stock: both are derived (ADR-005, ADR-013).
model Product {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name      String
  sellPrice Decimal @map("sell_price") @db.Decimal(18, 2)
  isActive  Boolean @default(true) @map("is_active")

  /// Waste allowance in percent; affects HPP only, never stock deduction (ADR-024).
  wastePercent Decimal @default(0) @map("waste_percent") @db.Decimal(5, 2)

  photoUrl String? @map("photo_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recipeItems RecipeItem[]
  saleItems   SaleItem[]

  @@unique([tenantId, name])
  @@map("products")
}

/// Bill of materials; a product's recipe is its set of rows.
model RecipeItem {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  productId     String @map("product_id")
  rawMaterialId String @map("raw_material_id")

  quantityUsed Decimal @map("quantity_used") @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Cascade: a recipe has no meaning without its product.
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Restrict: a raw material used by a recipe cannot be deleted.
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@unique([productId, rawMaterialId])
  @@index([productId])
  @@index([rawMaterialId])
  @@index([tenantId])
  @@map("recipe_items")
}

/// A sale: always at a real branch, always with its income ledger entry.
model Sale {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  branchId      String @map("branch_id")
  /// Payment method.
  accountId     String @map("account_id")
  /// The cashier, from the JWT.
  userId        String @map("user_id")
  ledgerEntryId String @unique @map("ledger_entry_id")

  /// Σ SaleItem.lineTotal; no tax or discount (ADR-015).
  totalAmount Decimal  @map("total_amount") @db.Decimal(18, 2)
  soldAt      DateTime @map("sold_at")

  /// Client idempotency key (TASK-082); the unique index enforces dedup.
  idempotencyKey String? @map("idempotency_key")

  /// A void flips this and writes reversal rows; the sale is never edited (DEBT-010).
  status         SaleStatus @default(COMPLETED) @map("status")
  voidedAt       DateTime?  @map("voided_at")
  voidedByUserId String?    @map("voided_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Restrict: a sale is financial history.
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  account      Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  user         User        @relation("SaleCashier", fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntry  LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)
  voidedByUser User?       @relation("SaleVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)

  items SaleItem[]

  @@unique([tenantId, idempotencyKey])
  @@index([branchId])
  @@index([soldAt])
  /// Dashboard 3 filters by date and usually by branch; KASIR always by branch.
  @@index([branchId, soldAt])
  @@index([userId])
  @@index([accountId])
  @@index([status])
  @@index([tenantId, branchId, soldAt])
  @@map("sales")
}

/// A sale line. Not unique per product: one product may appear at two prices.
model SaleItem {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  saleId    String @map("sale_id")
  productId String @map("product_id")

  quantity Decimal @db.Decimal(18, 4)

  /// Charged unit price: master price unless overridden.
  unitPriceAtSale   Decimal @map("unit_price_at_sale") @db.Decimal(18, 2)
  /// True only when the charged price differs from Product.sellPrice.
  isPriceOverridden Boolean @default(false) @map("is_price_overridden")

  /// Per-unit HPP frozen at sale time; never recomputed (ADR-005, ADR-015).
  hppAtSale Decimal @map("hpp_at_sale") @db.Decimal(18, 2)

  lineTotal Decimal @map("line_total") @db.Decimal(18, 2)

  /// Append-only: no updatedAt.
  createdAt DateTime @default(now()) @map("created_at")

  // Cascade with the sale; Restrict on product (financial history).
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@index([tenantId])
  @@map("sale_items")
}

/// OhMyPos — ERD §3.
model Supplier {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name    String
  /// Free text (phone, WhatsApp or a name).
  contact String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchases SupplierPurchase[]
  payables  Payable[]

  @@unique([tenantId, name])
  @@map("suppliers")
}

/// A supplier purchase. `branchId = null` is a central purchase; PAID gets a ledger entry, UNPAID a Payable (ADR-006).
model SupplierPurchase {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  supplierId String  @map("supplier_id")
  branchId   String? @map("branch_id")

  totalAmount   Decimal       @map("total_amount") @db.Decimal(18, 2)
  purchaseDate  DateTime      @map("purchase_date")
  paymentStatus PaymentStatus @map("payment_status")

  /// Set at creation iff PAID; otherwise null forever.
  ledgerEntryId String? @unique @map("ledger_entry_id")

  note String?

  /// Kunci idempotensi klien (TASK-082).
  idempotencyKey String? @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Restrict: a purchase is financial history.
  supplier    Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch      Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ledgerEntry LedgerEntry? @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)

  // Cascade with the purchase.
  items   SupplierPurchaseItem[]
  payable Payable?

  @@unique([tenantId, idempotencyKey])
  @@index([supplierId])
  @@index([branchId])
  @@index([purchaseDate])
  /// Dashboard 2.2 lists purchases by branch and date; KASIR always filters by branch.
  @@index([branchId, purchaseDate])
  @@index([tenantId, branchId, purchaseDate])
  @@map("supplier_purchases")
}

/// A purchase line: what was bought (snapshot) and what stock received.
model SupplierPurchaseItem {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  supplierPurchaseId String @map("supplier_purchase_id")
  rawMaterialId      String @map("raw_material_id")

  /// Quantity in the purchase unit, as recorded (snapshot, ADR-024).
  purchaseQuantity Decimal @map("purchase_quantity") @db.Decimal(18, 4)
  /// Snapshot of RawMaterial.purchaseUnit as it was when this line was recorded.
  purchaseUnit     String  @map("purchase_unit")
  /// Snapshot of RawMaterial.conversionFactor as it was when this line was recorded.
  conversionFactor Decimal @map("conversion_factor") @db.Decimal(18, 4)

  /// Stock received: purchaseQuantity × conversionFactor, in the stock unit.
  quantity  Decimal @db.Decimal(18, 4)
  /// lineTotal ÷ quantity, per stock unit (a rate, 6dp).
  unitCost  Decimal @map("unit_cost") @db.Decimal(18, 6)
  /// Total price paid for the line, entered by the user (ADR-024).
  lineTotal Decimal @map("line_total") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")

  supplierPurchase SupplierPurchase @relation(fields: [supplierPurchaseId], references: [id], onDelete: Cascade)
  rawMaterial      RawMaterial      @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  /// One line per material per purchase.
  @@unique([supplierPurchaseId, rawMaterialId])
  @@index([supplierPurchaseId])
  @@index([rawMaterialId])
  @@index([tenantId])
  @@map("supplier_purchase_items")
}

/// Utang for an unpaid purchase. `remainingBalance` is written only by PayablesService.settle under a row lock.
model Payable {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// One payable per unpaid purchase.
  supplierPurchaseId String @unique @map("supplier_purchase_id")
  supplierId         String @map("supplier_id")

  originalAmount   Decimal       @map("original_amount") @db.Decimal(18, 2)
  remainingBalance Decimal       @map("remaining_balance") @db.Decimal(18, 2)
  status           PayableStatus @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplierPurchase SupplierPurchase    @relation(fields: [supplierPurchaseId], references: [id], onDelete: Restrict)
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  settlements      PayableSettlement[]

  @@index([supplierId])
  @@index([status])
  @@index([tenantId])
  @@map("payables")
}

/// A payment against a Payable: when money leaves the account (ADR-006).
model PayableSettlement {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  payableId     String @map("payable_id")
  accountId     String @map("account_id")
  /// Exactly one expense entry per settlement.
  ledgerEntryId String @unique @map("ledger_entry_id")

  amount    Decimal  @db.Decimal(18, 2)
  settledAt DateTime @map("settled_at")
  note      String?

  /// Kunci idempotensi klien (TASK-082).
  idempotencyKey String? @map("idempotency_key")

  /// Append-only.
  createdAt DateTime @default(now()) @map("created_at")

  payable     Payable     @relation(fields: [payableId], references: [id], onDelete: Restrict)
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  ledgerEntry LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([payableId])
  @@index([settledAt])
  @@map("payable_settlements")
}

/// Append-only log behind every change to RawMaterial.currentStock (ADR-007).
model StockMovement {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  rawMaterialId String  @map("raw_material_id")
  /// Attribution only; null for central events (ADR-004).
  branchId      String? @map("branch_id")

  direction StockDirection
  quantity  Decimal        @db.Decimal(18, 4)

  referenceType StockReferenceType @map("reference_type")
  /// Polymorphic source row (no foreign key).
  referenceId   String?            @map("reference_id")

  /// Decimal(18,6) — a per-unit rate, matching RawMaterial.unitCost (ADR-024).
  unitCostAtMovement Decimal  @map("unit_cost_at_movement") @db.Decimal(18, 6)
  movementDate       DateTime @map("movement_date")

  /// Append-only — no updatedAt (ERD §3).
  createdAt DateTime @default(now()) @map("created_at")

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: Restrict)

  /// Drives Dashboard 5's inventory summary (ERD §6).
  @@index([rawMaterialId, movementDate])
  /// Covering index for the inventory summary's carry-forward groupBy (DEBT-013).
  @@index([rawMaterialId, movementDate, direction])
  @@index([referenceType, referenceId])
  @@index([branchId])
  @@index([tenantId, rawMaterialId, movementDate, direction])
  @@map("stock_movements")
}

/// A monthly stock-take declaration; its correction is an OPENING StockMovement.
model OpeningStock {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  rawMaterialId String @map("raw_material_id")

  /// First day of the month (a calendar date, not an instant).
  periodMonth DateTime @map("period_month") @db.Date

  /// Physical count at the start of the period, not a delta.
  quantity Decimal @db.Decimal(18, 4)

  /// Required iff no purchase this period (PRD §5.5); otherwise null.
  unitPrice Decimal? @map("unit_price") @db.Decimal(18, 6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  /// One declaration per material per month.
  @@unique([rawMaterialId, periodMonth])
  @@index([periodMonth])
  @@index([tenantId])
  @@map("opening_stocks")
}

enum AttendanceViolationReason {
  NO_DEVICE_COOKIE
  DEVICE_NOT_REGISTERED
  DEVICE_WRONG_BRANCH
  DEVICE_INACTIVE
}

/// A POS terminal at a branch. The activation code exists only until activation (ADR-021).
model Device {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id")
  label    String

  isActive Boolean @default(false) @map("is_active")

  activatedByUserId String?   @map("activated_by_user_id")
  activatedAt       DateTime? @map("activated_at")

  /// Single-use, expiring activation code.
  activationCode          String?   @unique @map("activation_code")
  activationCodeExpiresAt DateTime? @map("activation_code_expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  activatedBy       User?              @relation(fields: [activatedByUserId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]

  @@index([branchId])
  @@index([tenantId])
  @@map("devices")
}

/// One row per KASIR login; informational only, never an access gate.
model AttendanceRecord {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  userId   String  @map("user_id")
  deviceId String? @map("device_id")

  loginAt DateTime @default(now()) @map("login_at")
  isValid Boolean  @map("is_valid")

  violationReason AttendanceViolationReason? @map("violation_reason")

  /// Informational; never used for isValid.
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@index([tenantId])
  @@map("attendance_records")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Leave (cuti) request, approved or rejected by an OWNER. Dates are calendar days.
model LeaveRequest {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId String @default("") @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  userId String @map("user_id")

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  reason    String

  status LeaveRequestStatus @default(PENDING)

  reviewedByUserId String?   @map("reviewed_by_user_id")
  reviewedAt       DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Requester and reviewer: two named relations to User.
  user       User  @relation("LeaveRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("LeaveRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([tenantId])
  @@map("leave_requests")
}

/// Business profile configuration — single record for business name, logo, and address.
model BusinessProfile {
  id String @id @default(uuid())

  /// Set by the tenant extension (ADR-025). `@default("")` is a typing device only; see prisma/README.md.
  tenantId  String   @unique @default("") @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String   @default("OhMyPos")
  logoUrl   String?  @map("logo_url")
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("business_profiles")
}

// ---------------------------------------------------------------------------
// v2 — multi-tenancy and the platform-operator identity (ADR-025).
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// One row per business (ADR-025). Tenant-edited details live in BusinessProfile.
model Tenant {
  id String @id @default(uuid())

  name String

  /// Human-readable identifier, never a routing key.
  slug   String       @unique
  status TenantStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts              Account[]
  categories            Category[]
  branches              Branch[]
  ledgerEntries         LedgerEntry[]
  bankTransactions      BankTransaction[]
  allocations           Allocation[]
  users                 User[]
  rawMaterials          RawMaterial[]
  products              Product[]
  recipeItems           RecipeItem[]
  sales                 Sale[]
  saleItems             SaleItem[]
  suppliers             Supplier[]
  supplierPurchases     SupplierPurchase[]
  supplierPurchaseItems SupplierPurchaseItem[]
  payables              Payable[]
  payableSettlements    PayableSettlement[]
  stockMovements        StockMovement[]
  openingStocks         OpeningStock[]
  devices               Device[]
  attendanceRecords     AttendanceRecord[]
  leaveRequests         LeaveRequest[]
  businessProfile       BusinessProfile?
  impersonationSessions ImpersonationSession[]

  @@map("tenants")
}

/// Platform operator; not a User, so User.tenantId stays NOT NULL (ADR-025).
model PlatformAdmin {
  id String @id @default(uuid())

  name             String
  email            String  @unique
  passwordHash     String  @map("password_hash")
  refreshTokenHash String? @map("refresh_token_hash")
  isActive         Boolean @default(true) @map("is_active")

  /// Same session-revocation pattern as User (ADR-011 §3).
  tokenValidFrom DateTime @default(now()) @map("token_valid_from")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  impersonations ImpersonationSession[]

  @@map("platform_admins")
}

/// Impersonation audit trail; append-only apart from `endedAt`.
model ImpersonationSession {
  id String @id @default(uuid())

  platformAdminId String @map("platform_admin_id")
  tenantId        String @map("tenant_id")
  /// The tenant's OWNER User whose identity is borrowed.
  actingAsUserId  String @map("acting_as_user_id")
  reason          String

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Restrict)
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([platformAdminId])
  @@index([tenantId, startedAt])
  @@map("impersonation_sessions")
}
