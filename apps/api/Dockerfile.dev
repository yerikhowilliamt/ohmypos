# syntax=docker/dockerfile:1
# Local development image for apps/api (System Design §10).
#
# Deliberately NOT a production build — source is bind-mounted and Nest runs in
# watch mode, so a code change is picked up without rebuilding.
#
# Dependencies are installed at BUILD time, not on container start: the
# node_modules volumes in docker-compose.yml are seeded from this image, so
# `docker compose up` does not re-download the dependency tree every time.
FROM node:22-alpine

# Prisma needs openssl at runtime; installed now so Phase 1 needs no rebuild.
RUN apk add --no-cache openssl

RUN corepack enable

WORKDIR /repo

# Manifests only, so the install layer is cached until a dependency changes.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/config/package.json ./packages/config/
COPY packages/ui/package.json ./packages/ui/
COPY packages/api-contracts/package.json ./packages/api-contracts/

# Only this app's subtree — `web`'s dependencies have no business in this image.
# Retries are raised because the container's link to the registry is slower and
# flakier than the host's.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile --filter api... \
  --store-dir /pnpm/store \
  --fetch-retries 5 \
  --fetch-retry-maxtimeout 120000 \
  --network-concurrency 4

COPY . .

EXPOSE 4013

CMD ["pnpm", "--filter", "api", "dev"]
