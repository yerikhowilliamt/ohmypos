# Copy to .env.local and fill in. Never commit the real file (Handbook §3, §6).

# Server-only target used by Next.js for SSR calls and the same-origin
# /api/v1 BFF Route Handler. In Vercel, set this to the Render API URL. The
# browser deliberately never calls this origin directly so auth cookies stay
# first-party.
INTERNAL_API_BASE_URL="http://localhost:4015/api/v1"
NEXT_PUBLIC_BUSINESS_NAME="Los Pollos Hermanos"
