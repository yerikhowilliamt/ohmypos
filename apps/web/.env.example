# Copy to .env.local and fill in. Never commit the real file (Handbook §3, §6).

# apps/web talks to apps/api over REST only (ADR-002) — never to the database.
# This value is read in the browser, so it must resolve from the host, not from
# inside the compose network.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4013/api/v1"
